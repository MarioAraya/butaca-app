# Database
DATABASE_PATH=data/cinepolis.db

# Scraper
SCRAPE_DELAY_SECONDS=20
SCRAPE_CRON_HOUR=6
SCRAPE_CRON_MINUTE=0

# API
API_ADMIN_KEY=change-me-in-production

# OMDb (IMDB ratings) — free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Alertas — URL que recibe un POST de texto cuando el scrape no termina en "success"
# (ej. https://ntfy.sh/<topic-privado>). Vacío = sin alertas.
ALERT_WEBHOOK_URL=
