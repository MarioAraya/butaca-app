# Variables for docker-compose.vps.yml itself (Traefik routing + ACME).
# Kept separate from .env (the app's own config) on purpose: docker compose's
# default variable substitution reads a file literally named ".env", which
# would otherwise also get injected into the api container via its
# `env_file: .env` and crash pydantic-settings (extra fields not permitted).
#
# Usage:
#   cp .env.deploy.example .env.deploy   # fill in real values
#   docker compose -f docker-compose.vps.yml --env-file .env.deploy up -d --build

ACME_EMAIL=tu-email@ejemplo.com
API_DOMAIN=api.tu-dominio.com
FRONTEND_DOMAIN=tu-dominio.com
